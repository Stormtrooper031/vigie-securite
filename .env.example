# =====================================================================
#  Vigie Sécurité - configuration (copier vers .env et adapter)
#  Ne jamais committer le fichier .env (mots de passe).
# =====================================================================

# --- Fuseau horaire des planifications (scan, courriels) --------------
TZ=America/Toronto

# --- Base de données PostgreSQL (éviter les caractères ; et " dans le mot de passe)
DB_PASSWORD=ChangezMoi_Vigie_2026

# --- Clé partagée scanner -> backend (chaîne aléatoire longue) --------
#   Générer :  openssl rand -hex 32   ou   [guid]::NewGuid()  (PowerShell)
INTERNAL_API_KEY=remplacer-par-une-longue-chaine-aleatoire

# --- Surveillance ------------------------------------------------------
# Intervalle entre deux scans (minutes). 360 = toutes les 6 h.
SCAN_INTERVAL_MINUTES=360
# OU heure fixe quotidienne (HH:mm). Si renseigné, remplace l'intervalle.
SCAN_DAILY_AT=
# Lancer un scan au démarrage du conteneur
SCAN_ON_STARTUP=true
SCAN_STARTUP_DELAY_SECONDS=30

# Clé API NVD gratuite (fortement recommandée : 50 requêtes/30 s au lieu de 5)
#   https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Inventaire initial : 0 = tout l'historique NVD de la technologie ;
# N = seulement les CVE modifiées dans les N derniers jours.
NVD_INITIAL_LOOKBACK_DAYS=0

# Activer/désactiver chaque source
SOURCE_NVD=true
SOURCE_KEV=true
SOURCE_MITRE=true
SOURCE_OSV=true
SOURCE_EPSS=true

# Proxy sortant si votre réseau l'exige (ex. http://proxy.mondomaine:8080)
HTTPS_PROXY=
HTTP_PROXY=

# --- Import automatique de config/stack.txt au démarrage du backend ---
STACK_IMPORT_ON_STARTUP=true

# --- Azure DevOps Services (import de la stack depuis les dépôts, lecture seule) ---
# Organisation (https://dev.azure.com/<organisation>) ; laisser vide pour désactiver
AZDO_ORGANIZATION=
# Projets à lire, séparés par des virgules (vide = tous les projets accessibles au PAT)
AZDO_PROJECTS=
# Personal Access Token : portée « Code (Read) » seulement (+ « Project and Team (Read) » si AZDO_PROJECTS est vide)
AZDO_PAT=

# --- SMTP --------------------------------------------------------------
# Par défaut : Mailpit (capture locale, http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vigie-securite@localhost
# Exemple relais Office 365 :
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_ENABLE_SSL=true
#   SMTP_USER=compte@domaine      SMTP_PASSWORD=...

# --- Notifications -----------------------------------------------------
NOTIFY_ENABLED=true
# Destinataires séparés par des virgules
NOTIFY_TO=equipe-securite@localhost
# Seuil minimal pour figurer dans un courriel : CRITICAL | HIGH | MEDIUM | LOW
NOTIFY_MIN_SEVERITY=HIGH
# Au-delà de ce seuil, courriel immédiat (sans attendre le résumé) : CRITICAL | HIGH | NONE
NOTIFY_IMMEDIATE_SEVERITY=CRITICAL
# Fréquence du résumé : immediate | hourly | daily | weekly
NOTIFY_FREQUENCY=daily
NOTIFY_DAILY_AT=07:30
NOTIFY_WEEKLY_DAY=Monday
# Inclure le détail des failles trouvées lors de l'inventaire initial
NOTIFY_INCLUDE_BASELINE=false
# URL du tableau de bord (liens dans les courriels)
DASHBOARD_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
